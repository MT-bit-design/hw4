# Copy this file to backend/.env and fill in real values. Never commit .env.

# Secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-value

# Set to true when served over HTTPS so the cookie gets the Secure flag.
COOKIE_SECURE=false

# Portkey gateway key for the chat assistant (OpenAI models via Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: Portkey provider slug from your Model Catalog (e.g. @openai-prod).
# Leave unset if your Portkey key already has a default provider/config.
# PORTKEY_PROVIDER=@your-provider-slug

# Optional: chat model name (default gpt-5.6-luna).
# CHAT_MODEL=gpt-5.6-luna
